{
  "name": "ai-resume-scanning-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend --prefix-colors green,cyan \"npm:backend\" \"npm:frontend\"",
    "backend": "node scripts/start-backend.js",
    "frontend": "npm --prefix frontend run dev -- --host 127.0.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}