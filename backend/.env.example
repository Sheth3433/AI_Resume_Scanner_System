DATABASE_URL=sqlite:///./resume_scanner.db
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MAX_FILE_SIZE=10485760
OCR_LANGUAGE=eng
OCR_MAX_PAGES=20
# Optional executable path when tesseract.exe is not on PATH
TESSERACT_CMD=
UPLOAD_DIR=tmp/uploads
APP_ENV=development
SECRET_KEY=replace-this-development-value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Supported values: openai, gemini. Keep the API key server-side.
AI_PROVIDER=
AI_API_KEY=
# OpenAI defaults to gpt-4o-mini; Gemini defaults to gemini-2.0-flash.
AI_MODEL=gpt-4o-mini